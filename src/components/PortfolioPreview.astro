---
import type { CollectionEntry } from 'astro:content';

interface Props {
	project: CollectionEntry<'work'>;
	showCategory?: boolean;
}

const { project, showCategory = false } = Astro.props;
const { data, slug } = project;
const category = showCategory ? data.typeLabel : undefined;
---

<a class:list={['card', { 'text-led': !data.img, 'has-category': !!category }]} href={`/work/${slug}`}>
	<div class="card-labels">
		<span class="title">{data.title}</span>
		{category && <span class="type-label">{category}</span>}
	</div>
	{
		data.img ? (
			<img src={data.img} alt={data.img_alt || ''} loading="lazy" decoding="async" />
		) : (
			<span class="fallback" aria-hidden="true" />
		)
	}
</a>

<style>
	.card {
		display: grid;
		grid-template: auto 1fr / auto 1fr;
		height: 11rem;
		background: var(--gradient-subtle);
		border: 1px solid var(--gray-800);
		border-radius: 0.75rem;
		overflow: hidden;
		box-shadow: var(--shadow-sm);
		text-decoration: none;
		font-family: var(--font-brand);
		font-size: var(--text-lg);
		font-weight: 500;
		transition: box-shadow var(--theme-transition);
	}

	.card:hover {
		box-shadow: var(--shadow-md);
	}

	.card-labels {
		grid-area: 1 / 1 / 2 / 3;
		z-index: 2;
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 0.5rem;
		margin: 0.5rem;
		pointer-events: none;
	}

	.title,
	.type-label {
		margin: 0;
		padding: 0.5rem 1rem;
		background: var(--gray-999);
		border-radius: 0.375rem;
	}

	.title {
		min-width: 0;
		color: var(--gray-200);
	}

	.type-label {
		flex: 0 1 auto;
		max-width: 11.5rem;
		padding: 0.35rem 0.75rem;
		border-radius: 999rem;
		color: var(--gray-300);
		font-family: var(--font-body);
		font-size: var(--text-sm);
		font-weight: 400;
		line-height: 1.25;
		text-align: center;
		box-shadow: inset 0 0 0 1px var(--gray-800);
	}

	.has-category .title {
		max-width: calc(100% - 7.5rem);
	}

	img,
	.fallback {
		grid-area: 1 / 1 / 3 / 3;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.fallback {
		background:
			radial-gradient(circle at 20% 20%, var(--accent-overlay), transparent 45%),
			var(--gradient-subtle);
	}

	.text-led .card-labels {
		align-self: end;
		margin-bottom: 1rem;
	}

	@media (min-width: 50em) {
		.card {
			height: 22rem;
			border-radius: 1.5rem;
		}

		.title {
			border-radius: 0.9375rem;
		}

		.has-category .title {
			max-width: calc(100% - 9rem);
		}

		.type-label {
			max-width: 12.5rem;
		}
	}
</style>
